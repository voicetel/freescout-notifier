[Unit]
Description=FreeScout Notifier (real-time ticket alerts to Slack)
Documentation=https://github.com/voicetel/freescout-notifier
After=network-online.target mysql.service mariadb.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/freescout-notifier --config-file /etc/freescout-notifier/config.json
Restart=on-failure
RestartSec=5

# Hardening
User=freescout-notifier
Group=freescout-notifier
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/freescout-notifier
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=freescout-notifier

[Install]
WantedBy=multi-user.target
